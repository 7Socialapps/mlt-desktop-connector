# Dependencies
node_modules/
target/

# Build output
dist/
src-tauri/target/

# Environment (never commit secrets)
.env
.env.local
.env.*.local

# Local runtime artifacts (never commit)
credentials.enc
credentials.key
.credential_key
device_id
browser-profile/
job-assets/
# Runtime diagnostic PNG captures (app-data); not Rust source under src-tauri/src/runtime/diagnostics/
/diagnostics/
**/diagnostics/
*.png
*.jpg
*.jpeg
*.webp
!docs/**/*.png
# Brand / bundle icons (tracked intentionally)
!assets/**/*.png
!src-tauri/icons/**/*.png
!src-tauri/icons/**/*.ico
!src-tauri/icons/**/*.icns

# Logs
logs/
*.log

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Tauri
src-tauri/gen/

# Playwright sidecar dev state
browser-sidecar/.browser-test-state.json
# Copied into the app bundle at build time (see scripts/prepare-bundle-resources.sh)
browser-sidecar/node_modules/
packaging/node/
packaging/ms-playwright/

dist-release/
packaging/node-arm64/
packaging/node-x64/
