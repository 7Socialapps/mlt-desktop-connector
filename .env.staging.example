# Staging-only configuration for MLT Desktop Connector.
# Copy to .env for local development. Production values are intentionally absent.

MLT_ENV=staging
MLT_SUPABASE_URL=https://your-staging-project.supabase.co
MLT_SUPABASE_ANON_KEY=your-staging-anon-key

# Optional: forwarded to Vite for frontend display (must match Rust runtime config)
VITE_MLT_ENV=staging
VITE_MLT_SUPABASE_URL=https://your-staging-project.supabase.co
